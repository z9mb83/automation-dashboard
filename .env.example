# Copy to .env.local for local runs. On Vercel set these in Project > Settings > Environment Variables.
# Never commit real values.
SHEET_API_URL=        # AUTOMATION > Dashboard > Show feed link (the Apps Script web app URL ending in /exec)
SHEET_API_KEY=        # AUTOMATION > Dashboard > Create access key
DASHBOARD_PASSWORD=   # the password people type to open the dashboard
TELINFY_API_KEY=      # Telinfy API key, only for the SMS page (server side)
